@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
textbook:School
  rdf:type rdfs:Class;
  rdfs:comment "This resource represents type of schools such as elementary schools. URIs for the resources are represented as follows:<br><code>https://w3id.org/jp-textbook/school/<var>type of schools</var></code>"@en, "日本における学校制度上の初等・中等教育組織を表現するクラス。以下のようなURIにより表現されます。<br><code>https://w3id.org/jp-textbook/school/<var>学校</var></code>"@ja;
  rdfs:label "Type of school"@en, "学校種別"@ja;
  owl:sameAs schema:School.
textbook:CatalogueShape sh:property [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ].
textbook:CompilingProspectusShape sh:property [
    skos:example <textbook:school/小学校>;
    sh:class textbook:School;
    sh:description "Link to the type resource of schools, represented as <code>textbook:school/<var>type of school</var></code>."@en, "対応する学校種別を<code>textbook:school/<var>学校種別</var></code> として示される学校リソースと関連付ける"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ].
textbook:CurriculumGuidelineShape sh:property [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 5;
    sh:path textbook:school
  ].
textbook:SchoolShape sh:targetClass textbook:School.
textbook:SubjectTypeShape sh:property [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ].
textbook:TeachingUnitShape sh:property [
    skos:example <textbook:school/中学校>;
    sh:class textbook:School;
    sh:description "Link to the type resource of schools, represented as <code>textbook:school/<var>type of school</var></code>."@en, "対応する学校種別を<code>textbook:school/<var>学校種別</var></code> として示される学校リソースと関連付ける"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 6;
    sh:path textbook:school
  ].
textbook:TextbookShape sh:property [
    skos:example <textbook:school/中学校>;
    sh:class textbook:School;
    sh:description "Link to the type resource of schools, represented as <code>textbook:school/<var>type of school</var></code>."@en, "対応する学校種別を<code>textbook:school/<var>学校種別</var></code> として示される学校リソースと関連付ける"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 18;
    sh:path textbook:school
  ].
curriculum:SubjectAreaShape sh:property [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of school"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ].
curriculum:SubjectShape sh:property [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ].
textbook:school\/中学校 rdf:type textbook:School.
textbook:school\/小学校 rdf:type textbook:School.
textbook:school\/特別支援学校 rdf:type textbook:School.
textbook:school\/特殊教育諸学校 rdf:type textbook:School.
textbook:school\/高等学校 rdf:type textbook:School.
