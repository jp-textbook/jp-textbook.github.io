@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix qb: <http://purl.org/linked-data/cube#>.
@prefix cs: <https://w3id.org/jp-cos/>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
curriculum:SubjectAreaShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"国語\"@ja</li><li>\"こくご\"@ja-Hira</li><li>\"Japanese Language\"@en</li></ul>";
    sh:description "Using language tags, Japanese name, transcription of the name, and English name are shown. The meanings of language tags are as follows:  <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@ja-Hira</dt><dd>Japanese name (Hiragana). The name of the subject area is transcribed in Hiragana.</dd><dt>@en</dt><dd>English name of the subject area</dd></dl>Note that English names are unfficial one. Translation is done by the maintainers of this dataset. While we could not find the official English translations for the subject area, we refer to the tentative translations in the curriculum guidelines, and the English guide entitled \"Education in Japan\" published by the MEXT."@en, "言語コードを用いて、教科名に加え、そのよみ、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@ja-Hira</dt><dd>日本語名称（ひらがな表記）。教科名のよみをひらがな表記で示します。</dd><dt>@en</dt><dd>教科名の英語名称</dd></dl>注意：英訳名称は、文部科学省の正式なものではありません。翻訳の責任は、江草、高久にあります。 理由：大半の教科については、文部科学省が発表している正式な英語訳を見つけられませんでした（教育図書館へのレファレンス調査も実施済み）。 なお、学習指導要領の英訳（仮訳） （小学校、 中学校、 高等学校） に記載されている教科はそれらに由来するものです。 また、小学校、中学校の教科については、文部科学省が出している英語ガイド（Education In JAPAN, 13版）67ページの記載も参考にしました。 いずれにも記載のない教科名は、江草・高久によって一から英訳したものです。"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "ja-Hira";
        rdf:rest [
          rdf:first "en";
          rdf:rest rdf:nil
        ]
      ]
    ];
    sh:maxCount 3;
    sh:minCount 1;
    sh:name "Name"@en, "教科名"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of school"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ], [
    skos:example "1";
    sh:datatype xsd:integer;
    sh:description "This is used in the order of the listings."@en, "表示順を決める場合などで利用"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Listing order of the curriculum guideline"@en, "学習指導要領掲載順"@ja;
    sh:order 3;
    sh:path qb:order
  ], [
    skos:example <textbook:curriculum/高等学校/2013/Common>;
    sh:class textbook:SubjectType;
    sh:description "Used only in the subject areas at the curriculum guidelines 1994, 2003 and 2013 for the high schools."@en, "学習指導要領1994,2003,2013の高等学校の教科のみ。"@ja;
    sh:maxCount 1;
    sh:name "Type of the subject area"@en, "教科種別"@ja;
    sh:order 4;
    sh:path textbook:subjectType
  ], [
    skos:example cs:UpperSecondary\/2018\/国語;
    sh:class cs:SubjectArea;
    sh:maxCount 1;
    sh:name "Same resource"@en, "同一リソース"@ja;
    sh:order 5;
    sh:path owl:sameAs
  ], [
    skos:example <textbook:curriculum/高等学校/2013/国語/国語総合>;
    sh:class curriculum:Subject;
    sh:name "has a subject"@en, "種目（科目）がある"@ja;
    sh:order 6;
    sh:path textbook:hasSubject
  ], [
    skos:example textbook:source\/Elementary-2008;
    sh:class textbook:SourceOfEnglishName;
    sh:description "To provide the source information that serves as the basis for the English notation."@en, "英語表記の根拠となる出典情報を表す。"@ja;
    sh:maxCount 1;
    sh:name "Source of English name"@en, "英語表記出典"@ja;
    sh:order 7;
    sh:path textbook:sourceOfEnglishName
  ];
  sh:targetClass curriculum:SubjectArea.
