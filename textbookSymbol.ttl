@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:textbookSymbol
  rdf:type rdf:Property;
  rdfs:comment "教科書記号を表現するプロパティ"@ja;
  rdfs:domain textbook:Textbook;
  rdfs:label "Textbook symbol"@en, "教科書記号"@ja;
  rdfs:range rdf:Literal.
textbook:TextbookShape sh:property [
    skos:example "英語";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Texbook symbol"@en, "教科書記号"@ja;
    sh:order 13;
    sh:path textbook:textbookSymbol
  ].
