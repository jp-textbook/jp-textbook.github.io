@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:ChapterType
  rdf:type rdfs:Class;
  rdfs:comment "Resource for the type of compiling prospectus chapter (standard or advanced). URIs for the resources are represented as follows:<br><code>https://w3id.org/jp-textbook/curriculum/<var>type of chapter</var></code>"@en, "編修趣意書の章の種別を表現するクラス（標準、発展的な内容）。以下のようなURIにより表現されます。<br><code>https://w3id.org/jp-textbook/curriculum/<var>章種別</var></code>"@ja;
  rdfs:label "Chapter Type"@en, "章種別"@ja.
textbook:CPMappingACBody rdf:type textbook:ChapterType.
textbook:CPMappingACTable rdf:type textbook:ChapterType.
textbook:CPMappingLawOfEducation rdf:type textbook:ChapterType.
textbook:CPMappingTUBody rdf:type textbook:ChapterType.
textbook:ChapterCPShape sh:property [
    skos:example textbook:CPMappingTUTable;
    sh:class textbook:ChapterType;
    sh:description "CPMappingLawOfEducation, CPMappingTUBody, CPMappingTUTable, CPMappingACBody, CPMappingACTable のいずれかの値をとる。"@ja, "CPMappingLawOfEducation, CPMappingTUBody, CPMappingTUTable, CPMappingACBody, CPMappingACTable."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Compiling Prospectus Type"@en, "趣意書種別"@ja;
    sh:order 1;
    sh:path textbook:chapterType
  ].
textbook:ChapterTypeShape sh:targetClass textbook:ChapterType.
