@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix nier: <http://dl.nier.go.jp/library/vocab/>.
@prefix dct: <http://purl.org/dc/terms/>.
textbook:CurriculumGuidelineVersionShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"平成元年3月 告示\"@ja</li><li>\"1989-03 Notification\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "If the revision is on a part of a guideline, the name of the revision will be assigned such as \"Partial revision in December 2003\". Using language tags, Japanese and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "一部改正であれば、「平成15年12月 一部改正」のような表現となります。また、言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "en";
        rdf:rest rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name of the revision"@en, "別バージョンの名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example "1989-03-15";
    sh:datatype xsd:date;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Date of announcement (date of revision)"@en, "告示日（改正日）"@ja;
    sh:order 2;
    sh:path schema:datePublished
  ], [
    skos:example "<ul><li>\"『平成元年 文部省告示第二十四号』（官報. 平成元年3月15日, 号外特第4号, pp.9-50）\"@ja</li><li>\"\\\"Notification No. 24 in 1989 of the Ministry of Education, Science and Culture\\\" (Official Gazette, 1989-03-15, Special Extra Edition No. 4, pp.9-50)\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Refer to the official announcement and its publication. Using language tags, Japanese and English names shown. The meanings of language tags are as follows: <dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "文部科学省（文部省）の告示タイトルおよび掲載された官報についての情報。また、言語コードを用いて、出典に加え、英語の出典を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語出典（漢字表記）</dd><dt>@en</dt><dd>英語出典</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "en";
        rdf:rest rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Reference"@en, "出典"@ja;
    sh:order 3;
    sh:path schema:citation;
    sh:uniqueLang true
  ], [
    skos:example <http://www.mext.go.jp/a_menu/shotou/old-cs/1322235.htm>;
    sh:description "Repeatable. Links to the fulltext(s), such as MEXT website and <a href=\"http://www.nier.go.jp/guideline/\">NIER Curriculum Guidelines Database</a>."@en, "繰り返しあり。本文へのリンク。文部科学省ウェブページか<a href=\"http://www.nier.go.jp/guideline/\">国立教育政策研究所学習指導要領データベース</a>へのリンク。"@ja;
    sh:name "Fulltext URL"@en, "本文URL"@ja;
    sh:nodeKind sh:IRI;
    sh:order 4;
    sh:path schema:url
  ], [
    skos:example <http://id.ndl.go.jp/jpno/89034331>;
    sh:description "Repeatable. Links to <a href=\"http://iss.ndl.go.jp/\">NDL Search</a> and <a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>."@en, "繰り返しあり。<a href=\"http://iss.ndl.go.jp/\">国立国会図書館サーチ</a>、<a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>へのリンク。"@ja;
    sh:name "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 5;
    sh:path rdfs:seeAlso
  ], [
    skos:example "4171533104";
    sh:datatype xsd:string;
    sh:name "ISBN"@ja, "ISBN"@en;
    sh:order 6;
    sh:path schema:isbn
  ], [
    skos:example "071221843";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "Item identifier at the NIER Education Library"@en, "国立教育政策研究所教育図書館の蔵書データベースにおける所蔵資料ID"@ja;
    sh:order 7;
    sh:path nier:itemID
  ], [
    skos:example "375.92||1||1989d";
    sh:datatype xsd:string;
    sh:description "Delimiter for a call number is \"||\"."@en, "区切り記号は、「||」である。"@ja;
    sh:maxCount 1;
    sh:name "Call number at the NIER Education Library"@en, "国立教育政策研究所教育図書館の所蔵資料に対する請求記号"@ja;
    sh:order 8;
    sh:path nier:callNumber
  ], [
    skos:example "BB80025218";
    sh:datatype xsd:string;
    sh:description "<code>https://nieropac.nier.go.jp/ebopac/<var>レコードID</var></code>の形式で参照可能"@ja, "Link is available as <code>https://nieropac.nier.go.jp/ebopac/<var>record identifier</var></code>."@en;
    sh:maxCount 1;
    sh:name "Record identifier at the NIER Education Library"@en, "国立教育政策研究所教育図書館の蔵書データベースにおけるレコードID"@ja;
    sh:order 9;
    sh:path nier:recordID
  ];
  sh:targetClass textbook:CurriculumGuidelineVersion.
textbook:CurriculumGuidelineShape sh:property [
    sh:class textbook:CurriculumGuidelineVersion;
    sh:description "Repeatable. It corresponds to the revisions of the curriculum guideline. A revision information consists of a blank node, which has nine properties <code>schema:name</code>, <code>schema:datePublished</code>, <code>schema:citation</code>, <code>schema:url</code>, <code>rdfs:seeAlso</code>, <code>schema:isbn</code>, <code>nier:itemID</code>, <code>nier:callNumber</code>, and <code>nier:recordID</code>."@en, "複数の改正がある場合、改正の件数分、繰り返される。<code>schema:name</code>, <code>schema:datePublished</code>, <code>schema:citation</code>, <code>schema:url</code>, <code>rdfs:seeAlso</code>, <code>schema:isbn</code>, <code>nier:itemID</code>, <code>nier:callNumber</code>, <code>nier:recordID</code>の9つの改正情報用プロパティを持つ。"@ja;
    sh:name "Other versions"@en, "別バージョン情報"@ja;
    sh:node textbook:CurriculumGuidelineVersionShape;
    sh:nodeKind sh:BlankNode;
    sh:order 8;
    sh:path dct:hasVersion
  ].
