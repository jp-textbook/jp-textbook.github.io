@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix cs: <https://w3id.org/jp-cos/>.
@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix schema: <http://schema.org/>.
textbook:CosAboutShape
  rdf:type sh:NodeShape;
  sh:or [
    rdf:first cs:SubjectShape;
    rdf:rest [
      rdf:first cs:SubjectAreaShape;
      rdf:rest rdf:nil
    ]
  ].
curriculum:SubjectShape sh:property [
    skos:example cs:UpperSecondary\/2009\/国語\/国語総合;
    sh:maxCount 1;
    sh:name "Target subject or subject area"@en, "対象とする科目もしくは教科"@ja;
    sh:node textbook:CosAboutShape;
    sh:order 4;
    sh:path schema:about
  ].
