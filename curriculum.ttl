@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:curriculum
  rdf:type rdf:Property;
  rdfs:comment "対応する学習指導要領を表現するプロパティ"@ja;
  rdfs:domain textbook:SubjectType, textbook:Textbook;
  rdfs:label "Curriculum guideline"@en, "学習指導要領"@ja;
  rdfs:range textbook:CurriculumGuideline.
textbook:SourceOfEnglishNameShape sh:property [
    skos:example "curriculum/小学校/2012";
    sh:class textbook:CurriculumGuideline;
    sh:description "If the source is the English translation of the curriculum guideline, this property refer to the corresponding guideline."@en, "学習指導要領の仮訳が出典となっている場合は、対応する学習指導要領リソースのURIを示す。"@ja;
    sh:maxCount 1;
    sh:name "Reference to a curriculum guideline"@en, "対応学習指導要領"@ja;
    sh:order 2;
    sh:path textbook:curriculum
  ].
textbook:SubjectTypeShape sh:property [
    skos:example <textbook:curriculum/高等学校/2013>;
    sh:class textbook:CurriculumGuideline;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Curriculum guideline"@en, "学習指導要領"@ja;
    sh:order 3;
    sh:path textbook:curriculum
  ].
textbook:TextbookShape sh:property [
    skos:example <textbook:curriculum/中学校/2002>;
    sh:class textbook:CurriculumGuideline;
    sh:description "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var></code>として示される学習指導要領リソースと関連付ける"@ja, "Link to the curriculum guideline resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var></code>."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Curriculum Guideline"@en, "対応する学習指導要領"@ja;
    sh:order 17;
    sh:path textbook:curriculum
  ].
