    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/authorizedYear>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> <textbook:curriculum/中学校/2021/保健体育>;
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-textbook/curriculum/SubjectArea>;
    <http://www.w3.org/ns/shacl#description> "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var>/<var>教科</var></code>として示される科目リソースと関連付ける"@ja, "Link to the subject area resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var>/<var>subject area</var></code>."@en;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Subject area"@en, "教科"@ja;
    <http://www.w3.org/ns/shacl#order> 8;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/subjectArea>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> <textbook:curriculum/中学校/2021/保健体育/保健体育>;
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-textbook/curriculum/Subject>;
    <http://www.w3.org/ns/shacl#description> "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var>/<var>教科</var>/<var>科目</var></code>として示される種目（科目）リソースと関連付ける。"@ja, "Link to the subject resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var>/<var>subject area</var>/<var>subject</var></code>. "@en;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Subject"@en, "種目（科目）"@ja;
    <http://www.w3.org/ns/shacl#order> 9;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/subject>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "1, 2, 3";
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#integer>;
    <http://www.w3.org/ns/shacl#maxCount> 6;
    <http://www.w3.org/ns/shacl#name> "Target grade"@en, "対象学年"@ja;
    <http://www.w3.org/ns/shacl#order> 10;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/grade>
  ], [
    <http://www.w3.org/ns/shacl#class> <http://schema.org/Chapter>;
    <http://www.w3.org/ns/shacl#description> "<code>schema:isPartOf</code>と<code>schema:pagination</code>の2つのプロパティを持つ。複数の教科書がある場合、繰り返される。"@ja, "Link to the blank node resource(s), which consist of properties <code>schema:isPartOf</code> and <code>schema:pagination</code>. If there are multiple textbooks, this property values are repeated according to the number of textbooks times."@en;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Page of Textbook"@en, "教科書の該当ページ"@ja;
    <http://www.w3.org/ns/shacl#node> <https://w3id.org/jp-textbook/ChapterLUShape>;
    <http://www.w3.org/ns/shacl#nodeKind> <http://www.w3.org/ns/shacl#BlankNode>;
    <http://www.w3.org/ns/shacl#order> 11;
    <http://www.w3.org/ns/shacl#path> <http://schema.org/workExample>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> <textbook:AC100000000315/Time004>;
    <http://www.w3.org/ns/shacl#class> <http://schema.org/Duration>;
    <http://www.w3.org/ns/shacl#description> "Link to the duration resource."@en, "配当時数リソースと関連付ける。"@ja;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#name> "Duration"@en, "配当時数"@ja;
    <http://www.w3.org/ns/shacl#node> <https://w3id.org/jp-textbook/DurationLUShape>;
    <http://www.w3.org/ns/shacl#order> 12;
    <http://www.w3.org/ns/shacl#path> <http://schema.org/duration>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "体育分野 ２−Ｈ 第１学年及び第２学年（1）ア（ウ）,イ,ウ";
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#string>;
    <http://www.w3.org/ns/shacl#description> "This property refers to the section numbers of the corresponding courses of study items described in the compiling prospectus. This is a transcription of the information written in the compiling prospectus."@en, "編修趣意書に記述された単元に対応する学習指導要領の細目についての情報。原則、編修趣意書に記述されたまま転記したもの。"@ja;
    <http://www.w3.org/ns/shacl#name> "Section numbers of Course of Study Item from Compiling Prospectus"@en, "転記した学習指導要領の細目（文字列）"@ja;
    <http://www.w3.org/ns/shacl#order> 13;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/cosMappingDescription>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "cs:83G1213811300000, cs:83G1213812000000, cs:83G1213813000000";
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-cos/Item>;
    <http://www.w3.org/ns/shacl#description> "Link to the expand course of study item, represented as <code>cs:<var>course of study code</var></code>. The \"Transcribed Course Of Study Item(Code)\" are expanded to include both roots and leaves."@en, "単元に対応した学習指導要領の細目を表す。<code>cs:<var>学習指導要領コード</var></code> として示される学習指導要領の細目リソースと関連付いている。「転記した学習指導要領の細目（コード）」を根や葉まで含めて拡張している。"@ja;
    <http://www.w3.org/ns/shacl#name> "Course Of Study Item"@en, "学習指導要領の細目"@ja;
    <http://www.w3.org/ns/shacl#order> 14;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-cos/cosItem>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "cs:83G1213811300000, cs:83G1213812000000, cs:83G1213813000000";
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-cos/Item>;
    <http://www.w3.org/ns/shacl#description> " It represents the details of the Courses of Study Items corresponding to the unit. It is associated with the Courses of Study resources shown as cs:Course guidelines code. It is expanded from the \"Course of Study Item from Compiling Prospectus\" to include higher- and lower-level items in the hierarchy."@en, "「転記した学習指導要領の細目（文字列）」の内容から<code>cs:<var>学習指導要領コード</var></code> として示される学習指導要領の細目リソースと関連付けた値"@ja;
    <http://www.w3.org/ns/shacl#name> "Course of Study Item from Compiling Prospectus"@en, "転記した学習指導要領の細目（コード）"@ja;
    <http://www.w3.org/ns/shacl#order> 15;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-cos/originalCosItem>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> <https://w3id.org/jp-textbook/AC100000000315>;
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-textbook/CompilingProspectus>;
    <http://www.w3.org/ns/shacl#description> "<code>textbook:<var>編修趣意書ID</var></code>として示される編修趣意書リソースと関連付ける"@ja, "Link to the compiling prospectus resource, represented as <code>textbook:<var>compiling prospectus ID</var></code>."@en;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Compiling Prospectus"@en, "編修趣意書"@ja;
    <http://www.w3.org/ns/shacl#order> 16;
    <http://www.w3.org/ns/shacl#path> <http://purl.org/dc/terms/source>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "Standard";
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-textbook/TeachingUnitType>;
    <http://www.w3.org/ns/shacl#description> "Indicates the type of teaching unit: Standard, UpperGradeContents (upper grades), or OutOfCos (content that is not required to be covered at any grade level in Courses of Study)."@en, "単元の類型を示す。Standard（標準）,UpperGradeContents（後の学年）,OutOfCos（学習指導要領上、どの学年等でも扱うこととされていない内容）の3つのどれかをとる。"@ja;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Teaching Unit Type"@en, "単元種別"@ja;
    <http://www.w3.org/ns/shacl#order> 17;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/teachingUnitType>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "315";
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#integer>;
    <http://www.w3.org/ns/shacl#description> "Used in display orders"@en, "表示順を決める場合などで利用"@ja;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Listing order"@en, "ソート順"@ja;
    <http://www.w3.org/ns/shacl#order> 18;
    <http://www.w3.org/ns/shacl#path> <http://purl.org/linked-data/cube#order>
  ];
  <http://www.w3.org/ns/shacl#targetClass> <https://w3id.org/jp-textbook/TeachingUnit> .
