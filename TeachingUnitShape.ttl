  ], [
    <http://www.w3.org/2004/02/skos/core#example> <textbook:school/中学校>;
    <http://www.w3.org/ns/shacl#class> <https://w3id.org/jp-textbook/School>;
    <http://www.w3.org/ns/shacl#description> "Link to the type resource of schools, represented as <code>textbook:school/<var>type of school</var></code>."@en, "対応する学校種別を<code>textbook:school/<var>学校種別</var></code> として示される学校リソースと関連付ける"@ja;
    <http://www.w3.org/ns/shacl#maxCount> 1;
    <http://www.w3.org/ns/shacl#minCount> 1;
    <http://www.w3.org/ns/shacl#name> "Type of schools"@en, "学校種別"@ja;
    <http://www.w3.org/ns/shacl#order> 6;
    <http://www.w3.org/ns/shacl#path> <https://w3id.org/jp-textbook/school>
  ], [
    <http://www.w3.org/2004/02/skos/core#example> "2020";
    <http://www.w3.org/ns/shacl#datatype> <http://www.w3.org/2001/XMLSchema#gYear>;
    <http://www.w3.org/ns/shacl#name> "Authorized year"@en, "検定年"@ja;
