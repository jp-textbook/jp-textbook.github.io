@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:grade
  rdf:type rdf:Property;
  rdfs:comment "学年を表現するプロパティ"@ja;
  rdfs:domain textbook:Textbook;
  rdfs:label "Grade"@en, "学年"@ja;
  rdfs:range rdfs:Literal.
textbook:CompilingProspectusShape sh:property [
    skos:example "1, 2";
    sh:datatype xsd:integer;
    sh:maxCount 6;
    sh:name "Target grade"@en, "対象学年"@ja;
    sh:order 6;
    sh:path textbook:grade
  ].
textbook:TeachingUnitShape sh:property [
    skos:example "1, 2, 3";
    sh:datatype xsd:integer;
    sh:maxCount 6;
    sh:name "Target grade"@en, "対象学年"@ja;
    sh:order 10;
    sh:path textbook:grade
  ].
textbook:TextbookShape sh:property [
    skos:example "1, 2, 3";
    sh:datatype xsd:integer;
    sh:maxCount 6;
    sh:name "Target grade"@en, "対象学年"@ja;
    sh:order 8;
    sh:path textbook:grade
  ].
