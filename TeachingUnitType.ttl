@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
textbook:TeachingUnitType
  rdf:type rdfs:Class;
  rdfs:comment "Resource for the type of teaching unit (standard or upper grade or out of course). URIs for the resources are represented as follows:<br><code>https://w3id.org/jp-textbook/curriculum/<var>type of teaching unit</var></code>"@en, "単元が標準的な学習内容か発展的な学習内容かの種別を表現するクラス（標準、上の学年の内容、学習指導要領外など）。以下のようなURIにより表現されます。<br><code>https://w3id.org/jp-textbook/curriculum/<var>単元種別</var></code>"@ja;
  rdfs:label "Teaching Unit Type"@en, "単元種別"@ja.
textbook:TeachingUnitShape sh:property [
    skos:example "Standard";
    sh:class textbook:TeachingUnitType;
    sh:description "Indicates the type of teaching unit: Standard, UpperGradeContents (upper grades), or OutOfCos (content that is not required to be covered at any grade level in Courses of Study)."@en, "単元の類型を示す。Standard（標準）,UpperGradeContents（後の学年）,OutOfCos（学習指導要領上、どの学年等でも扱うこととされていない内容）の3つのどれかをとる。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Teaching Unit Type"@en, "単元種別"@ja;
    sh:order 17;
    sh:path textbook:teachingUnitType
  ].
textbook:TeachingUnitTypeShape sh:targetClass textbook:TeachingUnitType.
curriculum:OutOfCos rdf:type textbook:TeachingUnitType.
curriculum:Standard rdf:type textbook:TeachingUnitType.
curriculum:UpperGrade rdf:type textbook:TeachingUnitType.
