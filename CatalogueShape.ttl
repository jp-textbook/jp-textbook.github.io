@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix nier: <http://dl.nier.go.jp/library/vocab/>.
textbook:CatalogueShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"高等学校用教科書目録(平成29年度使用)\"@ja</li><li>\"こうとうがっこうようきょうかしょもくろく（へいせい29ねんどしよう）\"@ja-Hira</li><li>\"Textbook Catalogue for Upper Secondary School of 2017 School Year\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese name, its transcription (Yomi) and English name are shown. The meanings of the language tags are as follows: <dl><dt>@ja</dt><dd>Japanese title (Kanji)</dd><dt>@ja-Hira</dt><dd>Japanese title (Hiragana)</dd><dt>@en</dt><dd>English title</dd></dl>"@en, "言語コードを用いて、書名に加え、そのよみ、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>書名（漢字表記）</dd><dt>@ja-Hira</dt><dd>書名（ひらがな表記）。名称のよみをひらがな表記で示します。</dd><dt>@en</dt><dd>英語書名</dd></dl>"@ja;
    sh:maxCount 3;
    sh:minCount 1;
    sh:name "Title"@en, "書名"@ja;
    sh:order 1;
    sh:path schema:name
  ], [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ], [
    skos:example "\"2016\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Publication date"@en, "発行年"@ja;
    sh:order 3;
    sh:path schema:datePublished
  ], [
    skos:example "\"2017\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:description "Usage year for textbooks listed in the catalogue."@en, "掲載している教科書の使用年度を表す。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Usage year"@en, "使用年度"@ja;
    sh:order 4;
    sh:path textbook:usageYear
  ], [
    skos:example <http://www.mext.go.jp/a_menu/shotou/kyoukasho/__icsFiles/afieldfile/2016/04/26/1369944_3.pdf>;
    sh:maxCount 1;
    sh:name "Fulltext URL"@en, "本文URL"@ja;
    sh:nodeKind sh:IRI;
    sh:order 5;
    sh:path schema:url
  ], [
    skos:example "<ul><li>https://web.archive.org/web/*/http://www.mext.go.jp/a_menu/shotou/kyoukasho/__icsFiles/afieldfile/2016/04/26/1369944_3.pdf</li><li>http://id.ndl.go.jp/jpno/000000045845</li><li>https://ci.nii.ac.jp/ncid/AN10586986</li></ul>";
    sh:description "Repeatable. Links to web archiving services (<a href=\"https://archive.org/web/\">Wayback Machine</a> and <a href=\"http://warp.ndl.go.jp/\">WARP</a> etc.), <a href=\"http://iss.ndl.go.jp\">NDL Search</a>, and <a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>."@en, "繰り返しあり。本文のアーカイブ（<a href=\"https://archive.org/web/\">Wayback Machine</a>, <a href=\"http://warp.ndl.go.jp/\">WARP</a>など）へのリンク、<a href=\"http://iss.ndl.go.jp\">国立国会図書館サーチ</a>、<a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>へのリンク"@ja;
    sh:name "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 6;
    sh:path rdfs:seeAlso
  ], [
    skos:example "400008926";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "Item identifier at the NIER Education Library"@en, "国立教育政策研究所教育図書館の蔵書データベースにおける所蔵資料ID"@ja;
    sh:order 7;
    sh:path nier:itemID
  ], [
    skos:example "375.9||27||2017";
    sh:datatype xsd:string;
    sh:description "Delimiter for a call number is \"||\""@en, "区切り記号は、「||」である。"@ja;
    sh:maxCount 1;
    sh:name "Call number at the NIER Education Library"@en, "国立教育政策研究所教育図書館の所蔵資料に対する請求記号"@ja;
    sh:order 8;
    sh:path nier:callNumber
  ], [
    skos:example "BB00014905";
    sh:datatype xsd:string;
    sh:description "<code>https://nieropac.nier.go.jp/ebopac/<var>レコードID</var></code>の形式で参照可能"@ja, "Link is available as <code>https://nieropac.nier.go.jp/ebopac/<var>record identifier</var></code>."@en;
    sh:maxCount 1;
    sh:name "Record identifier at the NIER Education Library"@en, "国立教育政策研究所教育図書館の蔵書データベースにおけるレコードID"@ja;
    sh:order 9;
    sh:path nier:recordID
  ];
  sh:targetClass textbook:Catalogue.
