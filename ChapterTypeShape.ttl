@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
textbook:ChapterTypeShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"教育基本法との対照表\"@ja;</li><li>\"Mapping Table of Law of Education\"@en;</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese name and English name are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>名称（日本語表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "ja-Hira";
        rdf:rest [
          rdf:first "en";
          rdf:rest rdf:nil
        ]
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name"@en, "名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example <https://www.mext.go.jp/a_menu/shotou/kyoukasho/1260070.htm>;
    sh:description "Links to the referenced website."@en, "出典した本文を参照できるWebページへのリンク。"@ja;
    sh:name "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 2;
    sh:path rdfs:seeAlso
  ];
  sh:targetClass textbook:ChapterType.
