@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix bf: <http://id.loc.gov/ontologies/bibframe/>.
@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dct: <http://purl.org/dc/terms/>.
textbook:TextbookShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "NEW CROWN ENGLISH SERIES 3";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Title"@en, "書名"@ja;
    sh:order 1;
    sh:path schema:name
  ], [
    skos:example "森住衛 ほか29名";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Editor(s)"@en, "編著者名"@ja;
    sh:order 2;
    sh:path schema:editor
  ], [
    skos:example <textbook:publisher/2003/三省堂>;
    sh:class textbook:Publisher;
    sh:description "<code>textbook:publisher/<var>掲載教科書目録の発行年</var>/<var>発行者略称</var></code>として示される発行者をあらわすリソースと関連付ける"@ja, "Link to the publisher resource, represented as <code>textbook:publisher/<var>catalogue publication year</var>/<var>publisher's abbriviated name</var></code>"@en;
    sh:minCount 1;
    sh:name "Publisher"@en, "出版者名"@ja;
    sh:order 3;
    sh:path schema:publisher
  ], [
    skos:example "改訂版";
    sh:datatype xsd:string;
    sh:description "※バージョン2.0までのデータ内には版情報が入っているレコードはない（古い教科書の場合のために念のため用意している）。"@ja;
    sh:name "Edition"@en, "版情報"@ja;
    sh:order 4;
    sh:path schema:bookEdition
  ], [
    skos:example "978-4-385-70190-5";
    sh:datatype xsd:string;
    sh:description "※バージョン6.0以降のデータの一部に追加。※バージョン6.1以降、複数ある場合、繰り返される。"@ja;
    sh:name "ISBN"@ja, "ISBN"@en;
    sh:order 5;
    sh:path schema:isbn
  ], [
    skos:example "120";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "The total pages"@en, "ページ数"@ja;
    sh:order 6;
    sh:path bf:extent
  ], [
    skos:example "B4";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "Dimensions"@en, "大きさ"@ja;
    sh:order 7;
    sh:path bf:dimensions
  ], [
    skos:example "1, 2, 3";
    sh:datatype xsd:integer;
    sh:maxCount 6;
    sh:name "Target grade"@en, "対象学年"@ja;
    sh:order 8;
    sh:path textbook:grade
  ], [
    skos:example "\"2001\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:name "Authorized year"@en, "検定年"@ja;
    sh:order 9;
    sh:path textbook:authorizedYear
  ], [
    skos:example <textbook:catalogue/中学校/2004>;
    sh:class textbook:Catalogue;
    sh:description "<code>textbook:catalogue/<var>学校種別</var>/<var>教科書目録発行年</var></code>として示される教科書目録リソースと関連付ける。繰り返される（バージョン11.0より、初出だけでなく当該教科書が掲載されている全ての教科書目録を繰り返しで表現するように変更）。"@ja, "Link to the catalogue resources, represented as <code>textbook:catalogue/<var>type of school</var>/<var>first published year</var></code>. Since version 11.0, this property has changed to link to all the related catalogues."@en;
    sh:minCount 1;
    sh:name "Textbook catalogue"@en, "掲載教科書目録"@ja;
    sh:order 10;
    sh:path textbook:catalogue
  ], [
    skos:example "\"2005\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:minCount 1;
    sh:name "Usage year"@en, "使用年"@ja;
    sh:order 11;
    sh:path textbook:usageYear
  ], [
    skos:example "2005-2005";
    sh:datatype xsd:string;
    sh:description "\"yyyy-yyyy\" もしくは \"yyyy-\" となる。\"yyyy-\" の場合は、終了年が未定のことを示す。"@ja, "Either of \"yyyy-yyyy\" or \"yyyy-\". The value ending with \"-\" like \"yyyy-\" means that the end year is undecided."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Range of Usage years"@en, "使用年の区間"@ja;
    sh:order 12;
    sh:path textbook:usageYearRange;
    sh:pattern "^(\\d\\d\\d\\d|\\d\\d\\d\\d-(\\d\\d\\d\\d)?)(, (\\d\\d\\d\\d|\\d\\d\\d\\d-(\\d\\d\\d\\d)?))*$"
  ], [
    skos:example "英語";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Texbook symbol"@en, "教科書記号"@ja;
    sh:order 13;
    sh:path textbook:textbookSymbol
  ], [
    skos:example "904";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Textbook number"@en, "教科書番号"@ja;
    sh:order 14;
    sh:path textbook:textbookNumber
  ], [
    skos:example <textbook:curriculum/中学校/2002/外国語/英語>;
    sh:class curriculum:Subject;
    sh:description "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var>/<var>教科</var>/<var>科目</var></code>として示される種目（科目）リソースと関連付ける。専門教科 (<code>textbook:subjectType = Special</code>) の場合、少数の例外を除いて、機械的に書名と種目名との一致により種目を類推して追加したものであり、教育図書館が追加したデータではないことに注意。最長一致で解決できない例外は、江草・高久によって追加。"@ja, "Link to the subject resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var>/<var>subject area</var>/<var>subject</var></code>. Note that if the type of the subject is Special (<code>textbook:subjectType</code>), the subject is deternmined automatically by the longest match of the Subject name from the title of the textbook, and it does not added by the Library of Education. Some exceptional data is resolved by Drs. Egusa and Takaku."@en;
    sh:maxCount 1;
    sh:name "Subject"@en, "種目（科目）"@ja;
    sh:order 15;
    sh:path textbook:subject
  ], [
    skos:example <textbook:curriculum/中学校/2002/外国語>;
    sh:class curriculum:SubjectArea;
    sh:description "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var>/<var>教科</var></code>として示される科目リソースと関連付ける"@ja, "Link to the subject area resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var>/<var>subject area</var></code>."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Subject area"@en, "教科"@ja;
    sh:order 16;
    sh:path textbook:subjectArea
  ], [
    skos:example <textbook:curriculum/中学校/2002>;
    sh:class textbook:CurriculumGuideline;
    sh:description "<code>textbook:curriculum/<var>学校種別</var>/<var>学習指導要領施行年</var></code>として示される学習指導要領リソースと関連付ける"@ja, "Link to the curriculum guideline resource, represented as <code>textbook:curriculum/<var>type of school</var>/<var>year of curriculum guideline</var></code>."@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Curriculum Guideline"@en, "対応する学習指導要領"@ja;
    sh:order 17;
    sh:path textbook:curriculum
  ], [
    skos:example <textbook:school/中学校>;
    sh:class textbook:School;
    sh:description "Link to the type resource of schools, represented as <code>textbook:school/<var>type of school</var></code>."@en, "対応する学校種別を<code>textbook:school/<var>学校種別</var></code> として示される学校リソースと関連付ける"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 18;
    sh:path textbook:school
  ], [
    sh:class bf:Item;
    sh:description "<code>nier:recordID</code>と<code>nier:callNumber</code>、もしくは、<code>textbook-rc:recordID</code>と<code>textbook-rc:callNumber</code>の2つの所蔵情報用プロパティを持つ。複数の所蔵情報がある場合、所蔵情報の件数分、繰り返される。"@ja, "Link to the blank node resource(s), which consist of either of properties 1) <code>nier:recordID</code> and <code>nier:callNumber</code>, or 2) <code>textbook-rc:recordID</code> and <code>textbook-rc:callNumber</code>. If there are multiple holdings in a library, this property values are repeated according to the number of holdings times."@en;
    sh:minCount 1;
    sh:name "Holding item(s)"@en, "所蔵情報"@ja;
    sh:node textbook:ItemShape;
    sh:nodeKind sh:BlankNode;
    sh:order 19;
    sh:path textbook:item
  ], [
    skos:example <http://id.ndl.go.jp/jpno/89034331>;
    sh:description "Repeatable. Links to <a href=\"http://iss.ndl.go.jp/\">NDL Search</a> (via NDLBibID and JPNO) and <a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a> (via NCID)."@en, "繰り返しあり。<a href=\"http://iss.ndl.go.jp/\">国立国会図書館サーチ</a>(国立国会図書館の書誌ID（NDLBibID）と全国書誌番号（JPNO）を使用)、<a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>（NCIDを使用）へのリンク。"@ja;
    sh:name "Related link(s)"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 20;
    sh:path rdfs:seeAlso
  ], [
    skos:example "2009年度より出版社を「日本文教出版株式会社」に変更。";
    sh:datatype xsd:string;
    sh:name "Notes"@en, "注記"@ja;
    sh:order 21;
    sh:path bf:note
  ], [
    skos:example "「あたらしい こくご　一上」小学校 1年 国語|101（東書）2019年検定";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Bibliographic information"@en, "書誌情報"@ja;
    sh:order 22;
    sh:path dct:bibliographicCitation
  ];
  sh:targetClass textbook:Textbook.
