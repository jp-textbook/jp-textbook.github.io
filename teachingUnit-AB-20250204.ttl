  textbook:cosMappingDescription '''B（1）ア（イ）　三角形や四角形など多角形についての簡単な性質を理解すること。上記に関連して，三角形の３つの角の大きさの和などを調べる活動の中で，「内角」，「内角の和」の用語を知る。''';
  dct:source <https://w3id.org/jp-textbook/AC100000000091>.
<https://w3id.org/jp-textbook/AB100000000103> a <https://w3id.org/jp-textbook/TeachingUnit>;
  qb:order 103;
  textbook:teachingUnitType <https://w3id.org/jp-textbook/curriculum/OutOfCos>;
  schema:name '''四角形の関係を調べよう''';
  textbook:school <https://w3id.org/jp-textbook/school/小学校>;
  textbook:authorizedYear "2019"^^xsd:gYear;
  textbook:subjectArea <https://w3id.org/jp-textbook/curriculum/小学校/2020/算数>;
  textbook:subject <https://w3id.org/jp-textbook/curriculum/小学校/2020/算数/算数>;
  textbook:grade 5;
  schema:workExample [
    a schema:Chapter;
    schema:isPartOf <https://w3id.org/jp-textbook/小学校/2019/算数/506>;
