@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix textbook-rc: <http://dl.nier.go.jp/library/vocab/textbook-rc/>.
textbook:ItemTextbookRCShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "220050110";
    sh:datatype xsd:string;
    sh:description "<code>http://textbook-rc-lib.net/Opac/search.htm?s=SsaOkobBIBy2ftPelVbXwTJqTVi&ncid=<var>レコードID</var></code>の形式で参照可能"@ja, "It is possible to refer to the record at the website as follows: <code>http://textbook-rc-lib.net/Opac/search.htm?s=SsaOkobBIBy2ftPelVbXwTJqTVi&ncid=<var>record ID</var></code>"@en;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Record identifier at the Textbook Library of Textbook Research Center Textbook Catalogue Information Database."@en, "教科書研究センター附属教科書図書館の教科書目録情報データベースにおけるレコードID"@ja;
    sh:order 1;
    sh:path textbook-rc:recordID
  ], [
    skos:example "B2|600|H17/18";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Call number for the item at the Textbook Library of Textbook Research Center."@en, "教科書研究センター附属教科書図書館の所蔵資料にたいする請求記号"@ja;
    sh:order 2;
    sh:path textbook-rc:callNumber
  ];
  sh:targetClass textbook:ItemTextbookRC.
textbook:ItemShape sh:or [
    rdf:first textbook:ItemNIERShape;
    rdf:rest [
      rdf:first textbook:ItemTextbookRCShape;
      rdf:rest rdf:nil
    ]
  ].
