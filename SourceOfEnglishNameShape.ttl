@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dct: <http://purl.org/dc/terms/>.
textbook:SourceOfEnglishNameShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"小学校学習指導要領英訳版（仮訳）(平成20年3月)\"@ja</li><li>\"Elementary School Curriculum Guideline English Version (Tentative Translation) (2008-03)\"@en</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, Japanese and English names are shown. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@en</dt><dd>English name</dd></dl>"@en, "言語コードを用いて、名称に加え、英語名称を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>日本語名称（漢字表記）</dd><dt>@en</dt><dd>英語名称</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "en";
        rdf:rest rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name for the source"@en, "英語表記出典の名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example "curriculum/小学校/2012";
    sh:class textbook:CurriculumGuideline;
    sh:description "If the source is the English translation of the curriculum guideline, this property refer to the corresponding guideline."@en, "学習指導要領の仮訳が出典となっている場合は、対応する学習指導要領リソースのURIを示す。"@ja;
    sh:maxCount 1;
    sh:name "Reference to a curriculum guideline"@en, "対応学習指導要領"@ja;
    sh:order 2;
    sh:path textbook:curriculum
  ], [
    skos:example <http://www.mext.go.jp/a_menu/shotou/new-cs/youryou/eiyaku/1261037.htm>;
    sh:description "Links to the referenced website and the bibliographic information such as <a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a> when the source is a book."@en, "出典した本文を参照できるWebページへのリンクや、出典が本の場合は書誌データ（<a href=\"https://ci.nii.ac.jp/books/\">CiNii Books</a>）へのリンクなど。"@ja;
    sh:name "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 3;
    sh:path rdfs:seeAlso
  ], [
    skos:example "\"2018-08-12\""^^xsd:date;
    sh:datatype xsd:date;
    sh:description "Date of reference for this source"@en, "この出典を参照した日"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Reference Date"@en, "参照日"@ja;
    sh:order 4;
    sh:path dct:date
  ];
  sh:targetClass textbook:SourceOfEnglishName.
