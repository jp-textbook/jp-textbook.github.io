@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:publisherAbbreviation
  rdf:type rdf:Property;
  rdfs:comment "発行者の略表記を示すプロパティ"@ja;
  rdfs:domain textbook:Publisher;
  rdfs:label "Abbreviation form of publisher"@en, "発行者略称"@ja;
  rdfs:range rdfs:Literal.
textbook:CompilingProspectusShape sh:property [
    skos:example "教出";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Abbreviation for the publisher"@en, "発行者略称"@ja;
    sh:order 7;
    sh:path textbook:publisherAbbreviation
  ].
textbook:PublisherShape sh:property [
    skos:example "友社";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Abbreviation for the publisher"@en, "発行者略称"@ja;
    sh:order 5;
    sh:path textbook:publisherAbbreviation
  ].
