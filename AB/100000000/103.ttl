textbook:AB100000000103
  dct:source textbook:AC100000000091;
  qb:order 103;
  schema:name "四角形の関係を調べよう";
  schema:workExample [
    schema:isPartOf textbook:小学校\/2019\/算数\/506;
    schema:numberOfPages 1;
