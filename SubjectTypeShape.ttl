@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
textbook:SubjectTypeShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"各学科に共通する各教科\"@ja;</li><li>\"かくがっかにきょうつうするかくきょうか\"@ja-Hira;</li></ul>";
    sh:datatype rdf:langString;
    sh:description "言語コードを用いて、名称に加え、そのよみを示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>名称（漢字表記）</dd><dt>@ja-Hira</dt><dd>名称（ひらがな表記）。名称のよみをひらがな表記で示します。</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "ja-Hira";
        rdf:rest rdf:nil
      ]
    ];
    sh:maxCount 2;
    sh:minCount 1;
    sh:name "Name"@en, "名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example <textbook:school/高等学校>;
    sh:class textbook:School;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Type of schools"@en, "学校種別"@ja;
    sh:order 2;
    sh:path textbook:school
  ], [
    skos:example <textbook:curriculum/高等学校/2013>;
    sh:class textbook:CurriculumGuideline;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Curriculum guideline"@en, "学習指導要領"@ja;
    sh:order 3;
    sh:path textbook:curriculum
  ], [
    skos:example "学習指導要領の章タイトルなど（「第２章 各学科に共通する各教科」「第３章 主として専門学科において開設される各教科」）や、学習指導要領冒頭の「学 校 教 育 法 施 行 規 則（抄）」の表題（pp. iii-iv ）など";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Reference"@en, "出典"@ja;
    sh:order 4;
    sh:path schema:citation
  ];
  sh:targetClass textbook:SubjectType.
