@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:unit3
  rdf:domain textbook:TeachingUnit;
  rdf:range rdf:Literal;
  rdf:type rdf:Property;
  rdfs:comment "A property divides a unit name into hierarchical units and describes it. This property represents the unit name of the third largest unit."@en, "単元名を階層ごとに分割して記述するためのプロパティ。3番目に大きな単位の単元名を表現する。"@ja;
  rdfs:label "Unit Title Level 3"@en, "ユニット単元名レベル3"@ja;
  rdfs:subPropertyOf schema:name.
textbook:TeachingUnitShape sh:property [
    skos:example "１章   スポーツの多様性";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "Unit Title Level 3"@en, "単元名レベル3"@ja;
    sh:order 4;
    sh:path textbook:unit3
  ].
