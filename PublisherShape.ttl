@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix schema: <http://schema.org/>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix bf: <http://id.loc.gov/ontologies/bibframe/>.
textbook:PublisherShape
  rdf:type sh:NodeShape;
  sh:property [
    skos:example "<ul><li>\"音楽之友社\"@ja;</li><li>\"おんがく の ともしゃ\"@ja-Hira;</li><li>\"Ongaku No Tomosha\"@ja-Latn;</li></ul>";
    sh:datatype rdf:langString;
    sh:description "Using language tags, the name and its transcription (Yomi) in Hiragana and in Alphabetical form. The meanings of language tags are as follows:<dl><dt>@ja</dt><dd>Japanese name (Kanji)</dd><dt>@ja-Hira</dt><dd>Japanese name in Hiragana.</dd><dt>@ja-Latn</dt><dd>Japanese name in an alphabetical form.</dd></dl>"@en, "言語コードを用いて、名称に加え、そのよみ、よみのローマ字表記を示します。言語コードとその意味は以下の通りです。<dl><dt>@ja</dt><dd>名称（漢字表記）</dd><dt>@ja-Hira</dt><dd>名称（ひらがな表記）。名称のよみをひらがな表記で示します。</dd><dt>@ja-Latn</dt><dd>名称（ローマ字表記）。名称のよみをローマ字表記で示します。</dd></dl>"@ja;
    sh:languageIn [
      rdf:first "ja";
      rdf:rest [
        rdf:first "ja-Hira";
        rdf:rest [
          rdf:first "ja-Latn";
          rdf:rest rdf:nil
        ]
      ]
    ];
    sh:maxCount 3;
    sh:minCount 1;
    sh:name "Name"@en, "名称"@ja;
    sh:order 1;
    sh:path schema:name;
    sh:uniqueLang true
  ], [
    skos:example <https://id.ndl.go.jp/auth/ndlna/00258007>;
    sh:description "Repeatable. Links to <a href=\"https://hojin-info.go.jp/hojin/TopPage\">Houjin Info</a>, <a href=\"https://id.ndl.go.jp/auth/ndla\">Web NDL Authorities</a> and <a href=\"http://ja.dbpedia.org/\">DBpedia</a>."@en, "繰り返しあり。<a href=\"https://hojin-info.go.jp/hojin/TopPage\">法人インフォ</a>、<a href=\"https://id.ndl.go.jp/auth/ndla\">Web NDL Authorities</a>、<a href=\"http://ja.dbpedia.org/\">DBpedia</a>へのリンク"@ja;
    sh:name "Related links"@en, "関連リンク"@ja;
    sh:nodeKind sh:IRI;
    sh:order 2;
    sh:path rdfs:seeAlso
  ], [
    skos:example "\"2017\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Publication year for a textbook catalogue where the publisher is listed"@en, "掲載教科書目録の発行年"@ja;
    sh:order 3;
    sh:path textbook:catalogueYear
  ], [
    skos:example <textbook:catalogue/高等学校/2017>;
    sh:class textbook:Catalogue;
    sh:description "Repeatable. Add link to the textbook catalogue resource represented as <code>textbook:catalogue/<var>type of schools</var>/<var>catalogue publication year</var></code>"@en, "繰り返しあり。<code>textbook:catalogue/<var>学校種別</var>/<var>教科書目録発行年</var></code>として示される教科書目録リソースと関連付ける"@ja;
    sh:minCount 1;
    sh:name "Textbook catalogue listed"@en, "掲載教科書目録"@ja;
    sh:order 4;
    sh:path textbook:catalogue
  ], [
    skos:example "友社";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Abbreviation for the publisher"@en, "発行者略称"@ja;
    sh:order 5;
    sh:path textbook:publisherAbbreviation
  ], [
    skos:example "89";
    sh:datatype xsd:string;
    sh:description "Repeatable. ex. <a href=\"https://w3id.org/jp-textbook/publisher/2009/日文\">textbook:publisher/2009/日文</a>."@en, "繰り返しあり。（例：<a href=\"https://w3id.org/jp-textbook/publisher/2009/日文\">textbook:publisher/2009/日文</a>）"@ja;
    sh:minCount 1;
    sh:name "Publisher number"@en, "発行者番号"@ja;
    sh:order 6;
    sh:path textbook:publisherNumber
  ], [
    skos:example "発行者番号が2種類ある（大阪書籍の教科書は発行者番号：3）。";
    sh:datatype xsd:string;
    sh:maxCount 1;
    sh:name "Notes"@en, "注記"@ja;
    sh:order 7;
    sh:path bf:note
  ];
  sh:targetClass textbook:Publisher.
