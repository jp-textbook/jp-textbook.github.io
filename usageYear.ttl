@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix dct: <http://purl.org/dc/terms/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:usageYear
  rdf:type rdf:Property;
  rdfs:comment "教科書の使用年を表現するプロパティ"@ja;
  rdfs:domain textbook:Catalogue, textbook:Textbook;
  rdfs:label "Usage year"@en, "使用年"@ja;
  rdfs:range rdf:Literal;
  rdfs:subPropertyOf dct:date.
textbook:CatalogueShape sh:property [
    skos:example "\"2017\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:description "Usage year for textbooks listed in the catalogue."@en, "掲載している教科書の使用年度を表す。"@ja;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "Usage year"@en, "使用年度"@ja;
    sh:order 4;
    sh:path textbook:usageYear
  ].
textbook:TextbookShape sh:property [
    skos:example "\"2005\""^^xsd:gYear;
    sh:datatype xsd:gYear;
    sh:minCount 1;
    sh:name "Usage year"@en, "使用年"@ja;
    sh:order 11;
    sh:path textbook:usageYear
  ].
