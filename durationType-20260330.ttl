@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix schema: <http://schema.org/>.
@prefix textbook:  <https://w3id.org/jp-textbook/> .
#TTL
<https://w3id.org/jp-textbook/durationType/Standard> a <https://w3id.org/jp-textbook/DurationType> ;
  schema:name "標準"@ja, "Standard"@en .
<https://w3id.org/jp-textbook/durationType/Flexible> a <https://w3id.org/jp-textbook/DurationType> ;
  schema:name "適宜や随時"@ja, "Flexible"@en .
<https://w3id.org/jp-textbook/durationType/Optional> a <https://w3id.org/jp-textbook/DurationType> ;
  schema:name "オプション"@ja, "Optional"@en .
<https://w3id.org/jp-textbook/durationType/Spare> a <https://w3id.org/jp-textbook/DurationType> ;
  schema:name "予備"@ja, "Spare"@en .

