@prefix textbook: <https://w3id.org/jp-textbook/>.
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix curriculum: <https://w3id.org/jp-textbook/curriculum/>.
@prefix skos: <http://www.w3.org/2004/02/skos/core#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
textbook:hasSubject
  rdf:type rdf:Property;
  rdfs:comment "対応する種目を表現するプロパティ"@ja;
  rdfs:domain curriculum:SubjectArea;
  rdfs:label "has subject(s)"@en, "種目をもつ"@ja;
  rdfs:range curriculum:Subject.
curriculum:SubjectAreaShape sh:property [
    skos:example <textbook:curriculum/高等学校/2013/国語/国語総合>;
    sh:class curriculum:Subject;
    sh:name "has a subject"@en, "種目（科目）がある"@ja;
    sh:order 6;
    sh:path textbook:hasSubject
  ].
